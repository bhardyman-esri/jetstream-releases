        <item>
            <title>1.5.9</title>
            <pubDate>Wed, 21 Oct 2026 12:02:35 -0700</pubDate>
            <sparkle:version>20261021.1</sparkle:version>
            <sparkle:shortVersionString>1.5.9</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>26.0</sparkle:minimumSystemVersion>
            <sparkle:hardwareRequirements>arm64</sparkle:hardwareRequirements>
            <description><![CDATA[<h4>Added</h4>
<ul>
<li><strong>Save FWD Package</strong> exports the FWD HTML, a matching single-page PDF, and a shortcut to the SharePoint guide on choosing PDF or HTML for sharing email.</li>
<li><strong>Help &gt; Export Diagnostics</strong> bundles local app state and saved hang reports without including source email content. A main-thread watchdog records unresponsive periods for troubleshooting.</li>
</ul>
<h4>Fixed</h4>
<ul>
<li>Review Images keeps selection edits local until the sheet closes and isolates unchanged rows to reduce SwiftUI view-graph work.</li>
</ul>]]></description>
            <enclosure url="https://github.com/bhardyman-esri/jetstream-releases/releases/download/v1.5.9-build-20261021.1/Jetstream-1.5.9-build-20261021.1.zip" length="10974569" type="application/octet-stream" sparkle:edSignature="IYFEkIp2vgT0Qsow+u/XEBN3XTpjx0FZD1EirYEPKy3jPC8vk5az+Le6FUKubKw+j62Vt4WjE1ZIzomrFqfGAg=="/>
